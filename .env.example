# ==============================================================================
# ChainCustody Configuration Environment Variables (.env)
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Blockchain RPC & Deployment Settings
# ------------------------------------------------------------------------------
# Primary custody chain JSON-RPC endpoint (Hardhat node or local validator)
RPC_URL=http://127.0.0.1:8545

# Polygon Amoy testnet JSON-RPC endpoint (used for testnet deployment)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deployer private key (use a throwaway dev account; NEVER use real funds)
PRIVATE_KEY=

# Deployed address of ChainCustody / ChainCustodyCommit contract (optional, auto-resolved from deployments/)
CHAINCUSTODY_ADDRESS=

# Deployed address of the Two-Person RoleCouncil multi-sig contract (optional)
ROLE_COUNCIL_ADDRESS=

# ------------------------------------------------------------------------------
# 2. Web Dashboard & Server Hardening
# ------------------------------------------------------------------------------
# Local server port (default: 3000)
PORT=3000

# Server network bind host (default: 127.0.0.1 for local isolation)
HOST=127.0.0.1

# Demo simulation mode (default: false).
# When true: runs simulation with mock personas on 127.0.0.1 with top warning banner.
# When false: enforces real MetaMask wallet connection and EIP-4361 SIWE authentication.
DEMO_MODE=false

# Secret key used for signing server-side sessions and SIWE cookies (optional, auto-generated if omitted)
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. Cross-Chain Checkpoint Witness Service (scripts/witness.js)
# ------------------------------------------------------------------------------
# JSON-RPC endpoint of the independent witness chain (e.g. secondary node on port 8546)
WITNESS_RPC=http://127.0.0.1:8546

# Private key of the authorized witness signer on the witness chain
WITNESS_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Deployed address of CheckpointWitness.sol on the witness chain (optional, auto-resolved from deployments/)
WITNESS_CONTRACT_ADDRESS=

# Checkpoint frequency interval in blocks (default: 16 blocks)
WITNESS_K=16

# Unique bytes32 tag identifying the custody chain on the witness contract
CHAIN_TAG=chaincustody-main

# Polling interval in milliseconds for the witness service daemon (default: 3000ms)
WITNESS_POLL_INTERVAL=3000
